{
  "layer": "top",
  "position": "top",
  
  "modules-center": [ "clock#date", "clock",  "hyprland/workspaces", "pulseaudio", "hyprland/window"],

  "hyprland/workspaces": {
    "disable-scroll": false,   
    "all-outputs": true,      
    "persistent-workspaces": { 
      "1": [], "2": [], "3": [], "4": [], "5": []
    }
  },


  "hyprland/window": {
	  "format": "{}",
	  "max-length": 40,
	  "seperate-outputs": true
  },

  "mpris": {
	  "format": "{player_icon} {artist} - {title}",
	  "player-icons": {
		  "spotify": "",
		  "default": ""
	  }
  },

  "clock": { "format": "{:%H:%M}" },

  "clock#date": { "format": "{:%A %b %d}" },

  "cpu": { "format": " {usage}%"},

  "memory": {"format": " {}%"},

  "pulseaudio": {"format": "󰖀 {volume}%"}
}

