{
  "layer": "top",
  "position": "top",
  
  "modules-left": ["hyprland/workspaces", "custom/separatorRight", "hyprland/window", "pulseaudio"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "custom/separatorLeft", "clock#date", "cpu", "memory", "network"],

  "hyprland/workspaces": {
    "disable-scroll": false,   
    "all-outputs": true,      
    "persistent-workspaces": { 
      "1": [], "2": [], "3": [], "4": [], "5": [], "6": []
    }
  },

  "custom/separatorLeft": {
	  "format": " ", 
	  "tooltip": false
  },

  "custom/separatorRight": {
	  "format": " ", 
	  "tooltip": false
  },


  "hyprland/window": {
	  "format": "{}",
	  "max-length": 40,
	  "seperate-outputs": true
  },

  "mpris": {
	  "format": "{player_icon} {artist} - {title}",
	  "player-icons": {
		  "spotify": "",
		  "default": ""
	  }
  },

  "clock": { "format": "{:%H:%M}" },

  "clock#date": { "format": "{:%A %b %d}" },

  "cpu": { "format": " {usage}%"},

  "memory": {"format": " {}%"},

  "pulseaudio": {"format": "󰖀 {volume}%"}
}

